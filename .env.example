# Wajib diisi
PRIVATE_KEY=0xGANTI_DENGAN_PRIVATE_KEY_HOT_WALLET

# RPC untuk baca state blockchain
# Gratis: https://ethereum.publicnode.com | https://cloudflare-eth.com | https://rpc.ankr.com/eth
# Lebih stabil: daftar gratis di alchemy.com atau infura.io
RPC_URL=https://ethereum.publicnode.com

# RPC untuk submit TX via Flashbots (jangan diganti kecuali tau alasannya)
SUBMIT_RPC=https://rpc.flashbots.net/fast

# Jumlah GPU yang dipakai (sesuaikan dengan jumlah GPU fisik kamu)
NUM_GPUS=1

# Priority fee ke validator dalam Gwei
# Sepi: 1-3 | Normal: 5 | Kompetitif: 10-25
TIP_GWEI=5

# Set 1 untuk disable clear screen (log scroll biasa, cocok untuk logging/tmux)
NO_CLEAR=0
